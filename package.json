{
  "name": "fishing-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "node server/start.cjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:app": "tsc -b && vite build --mode electron",
    "app:dev": "npm run build:app && node electron/launch.cjs",
    "app:exe": "npm run build:app && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.3",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "main": "electron/main.cjs",
  "description": "Wind, swell, tide and rain for Australian coastal fishing spots.",
  "author": {
    "name": "Ronnie Dong"
  },
  "build": {
    "appId": "au.tideline.app",
    "productName": "Tideline",
    "copyright": "Forecast data from Open-Meteo. Map data from OpenStreetMap contributors.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-app/**/*",
      "server/**/*",
      "!server/data",
      "!server/**/*.test.js",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Tideline-${version}-portable.exe",
      "unicode": true
    }
  }
}

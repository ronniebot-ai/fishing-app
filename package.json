{
  "name": "fishing-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "db:indexes": "node --env-file-if-exists=.env.local scripts/indexes.ts",
    "db:audit": "node --env-file-if-exists=.env.local scripts/audit.ts",
    "db:bench": "node --env-file-if-exists=.env.local scripts/bench.ts"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@anthropic-ai/sdk": "^0.126.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "antd": "^6.6.3",
    "leaflet": "^1.9.4",
    "mongodb": "^7.6.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.79.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "description": "Wind, swell, tide and rain for Australian coastal fishing spots.",
  "author": {
    "name": "Ronnie Dong"
  },
  "engines": {
    "node": ">=22"

# An Atlas connection string. The free M0 tier is enough for this.
# Atlas -> Connect -> Drivers, then put the database user's password in.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Optional; defaults to "tideline".
MONGODB_DB=tideline

# Optional. Set it and the ask-about-this-spot panel appears; leave it unset
# and the panel is absent. Deliberately not set on the public deploy - see the
# README - because the key would be ours and every visitor's question billed
# to it.
# ANTHROPIC_API_KEY=sk-ant-...
